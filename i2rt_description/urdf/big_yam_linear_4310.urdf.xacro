<?xml version="1.0"?>
<robot name="i2rt_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="can_channel" default="can0"/>
  <xacro:arg name="use_mock_hardware" default="false"/>
  <!-- See big_yam_ros2_control.xacro's macro comment: true makes this arm
       hand-backdrivable (kp=0, kd=each joint's "compliant_kd" <param>)
       instead of holding position - intended for a teleoperation leader arm. -->
  <xacro:arg name="compliant_mode" default="false"/>

  <!-- Include big YAM arm and linear_4310 gripper macros -->
  <xacro:include filename="$(find i2rt_description)/urdf/big_yam_macro.xacro"/>
  <xacro:include filename="$(find i2rt_description)/urdf/gripper_linear_4310.xacro"/>
  <xacro:include filename="$(find i2rt_description)/urdf/big_yam_ros2_control.xacro"/>

  <!-- Materials -->
  <material name="orange">
    <color rgba="1.0 0.6 0.0 1.0"/>
  </material>

  <material name="gripper_green">
    <color rgba="0 0.4 0 1"/>
  </material>

  <material name="tip_blue">
    <color rgba="0.596078 0.788235 0.921569 1"/>
  </material>

  <!-- World link (fixed base) -->
  <link name="world"/>

  <!-- Instantiate big YAM arm -->
  <xacro:big_yam_arm prefix="" parent="world">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:big_yam_arm>

  <!-- Instantiate linear_4310 gripper directly on the arm's wrist link -->
  <xacro:gripper_linear_4310 prefix="" parent="link_6"/>

  <!-- ros2_control hardware description (harmless when only visualizing —
       controller_manager only opens the CAN channel once this hardware
       component is actually loaded and activated) -->
  <xacro:big_yam_ros2_control prefix="" can_channel="$(arg can_channel)" use_mock_hardware="$(arg use_mock_hardware)"
    compliant_mode="$(arg compliant_mode)"/>

</robot>
