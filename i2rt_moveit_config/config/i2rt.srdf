<?xml version="1.0" ?>
<!--
  Shared SRDF for both YAM-family variants (yam_crank_4310, big_yam_linear_4310).
  Both share identical joint/link naming for the 6-DOF arm chain
  (base_link, link_1..link_6, joint1..joint6), so one SRDF covers both — only
  the gripper's link names differ (crank_4310: gripper_base/left_finger/
  right_finger; linear_4310: tip_left/tip_right), and disable_collisions
  entries naming links absent from whichever URDF is actually loaded are
  simply ignored, so both are listed below without conflict.

  Hand-authored, NOT generated by the MoveIt Setup Assistant: the
  disable_collisions reasons are all "Adjacent" (kinematic chain adjacency),
  not the Setup Assistant's sampled self-collision check. Good enough for
  IK/URDF/motion-planning checks in sim; re-run through Setup Assistant later
  for a properly sampled collision matrix before trusting this for anything
  safety-relevant.
-->
<robot name="i2rt_arm">
  <group name="arm">
    <chain base_link="base_link" tip_link="link_6"/>
  </group>

  <!-- No "gripper" group/end_effector for now — gripper_joint has no
       ros2_control interface (see yam_ros2_control.xacro's comment: no
       calibration/remapping ported yet), so there's nothing to plan or
       execute against. Add back once that's implemented. -->

  <group_state name="home" group="arm">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="1.5"/>
    <joint name="joint3" value="1.5"/>
    <joint name="joint4" value="0"/>
    <joint name="joint5" value="0"/>
    <joint name="joint6" value="0"/>
  </group_state>

  <!-- Arm chain adjacency (identical for both variants) -->
  <disable_collisions link1="world" link2="base_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="link_1" reason="Adjacent"/>
  <disable_collisions link1="link_1" link2="link_2" reason="Adjacent"/>
  <disable_collisions link1="link_2" link2="link_3" reason="Adjacent"/>
  <disable_collisions link1="link_3" link2="link_4" reason="Adjacent"/>
  <disable_collisions link1="link_4" link2="link_5" reason="Adjacent"/>
  <disable_collisions link1="link_5" link2="link_6" reason="Adjacent"/>

  <!-- crank_4310 gripper adjacency (yam_crank_4310 only) -->
  <disable_collisions link1="link_6" link2="tcp" reason="Adjacent"/>
  <disable_collisions link1="tcp" link2="gripper_base" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="left_finger" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="right_finger" reason="Adjacent"/>
  <disable_collisions link1="left_finger" link2="right_finger" reason="Default"/>

  <!-- linear_4310 gripper adjacency (big_yam_linear_4310 only) -->
  <disable_collisions link1="link_6" link2="tip_right" reason="Adjacent"/>
  <disable_collisions link1="link_6" link2="tip_left" reason="Adjacent"/>
  <disable_collisions link1="tip_left" link2="tip_right" reason="Default"/>
</robot>
